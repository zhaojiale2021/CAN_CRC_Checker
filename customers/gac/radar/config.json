{
  "dbc": "dbc",
  "traces": ["trace"],
  "crc": {
    "preset": "CRC16/CCITT",
    "byte_swap": true,
    "profile_by_width": true,
    "profiles": {
      "p01": {
        "preset": "CRC8/SAE-J1850-ZERO",
        "dataid_position": "prepend",
        "byte_swap": false,
        "counter_max_valid": 14,
        "range": { "mode": "custom_range", "start_byte": 0, "end_byte": 30 }
      }
    },
    "skip": ["SYNC_FC_CRC"]
  },
  "range": {
    "mode": "custom_range",
    "start_byte": 0,
    "end_byte": 30
  },
  "dataid": {
    "json": "dbc/dataid.json",
    "position": "prepend",
    "byte_order": "lo_hi"
  },
  "signals": {
    "checksum_pattern": null,
    "rc_pattern": null
  },
  "filter": {
    "frame_ids": null,
    "max_frames": 2000
  },
  "output": {
    "format": "html",
    "file": "report.html",
    "only_failures": false
  },
  "rc": {
    "max_valid": null
  }
}
