__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
.pytest_cache/
.idea/
.vscode/

# Generated reports (frontend entry points are real sources, keep them)
*.html
!frontend/index.html
!frontend/dist/index.html
report*.csv
report*.json

# Python build artifacts (frontend/dist IS committed)
build/
/dist/

# Web version runtime artifacts (uploads are deleted after each run;
# reports and run metadata are regenerated)
/data/

# Frontend dev dependencies (frontend/dist IS committed)
frontend/node_modules/

# Local CI-parity virtualenvs (uv can recreate: uv venv --python 3.10 .venv-ci)
.venv*/

# Tool metadata
.reasonix/

# Generated agent-memory index (local only)
AGENTS.md

# Local git history backups
*.bundle

# Claude Code project settings (local only)
.claude/
