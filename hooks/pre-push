#!/bin/sh
# ============================================================
#  Pre-push hook: block the push unless lint + tests pass
#  * pylint 要求 0 message 且 10.00/10 —— CI 按退出码判定,分数四舍五入到
#    10.00 也会因为一条 W/C 而失败;
#  * pytest 用 uv 起 CI 同环境(py3.10 + requirements.txt)跑,兜住解释器差异
#    (例:canmatrix 子包在 py3.10 不会自动 import,本机 py3.14 却恰好被别人
#    先加载 —— 这类问题只有 CI 才会暴露)。
#
#  Installed from hooks/pre-push -> .git/hooks/pre-push
#  (run install-hooks.bat after cloning; .git/hooks is not
#  version-controlled, so the source lives in hooks/)
# ============================================================
set -e

TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

# 与 CI 同版本(requirements.txt 固定 pylint 3.3.9):本机默认环境可能是
# pylint 4.x,检查项更少 —— 只有装了 uv 才能复现 CI 的判定。
if command -v uv >/dev/null 2>&1; then
    # --no-project:别在仓库里生成 uv.lock(项目本身用 requirements.txt)
    PY="uv run --no-project --python 3.10 --with-requirements requirements.txt python"
else
    PY="python"
    echo "WARNING: 未找到 uv,用本机解释器($(python -V 2>&1))跑 lint/测试," \
         "与 CI 的 py3.9/3.10 可能有差异" >&2
fi

echo "== pylint check (required: 0 messages, 10.00/10) =="
set +e
OUT=$($PY -m pylint $(git ls-files '*.py') 2>&1)
RC=$?
set -e
echo "$OUT"

# 退出码非 0 = 有 message(位掩码:2 error / 4 warning / 8 refactor / 16 convention)
if [ "$RC" != "0" ]; then
    echo "ERROR: pylint 退出码 $RC —— 有告警/约定问题,先修掉再推" >&2
    exit 1
fi

SCORE=$(printf '%s\n' "$OUT" | sed -n 's/.*rated at \([0-9][0-9]*\.\?[0-9]*\)\/10.*/\1/p' | tail -n1)
if [ -z "$SCORE" ]; then
    echo "ERROR: could not parse pylint score" >&2
    exit 1
fi
if [ "$SCORE" != "10.00" ]; then
    echo "ERROR: pylint score is $SCORE/10, need 10.00/10 — fix issues before pushing" >&2
    exit 1
fi

echo "OK: pylint 10.00/10 (0 messages)"

echo "== pytest check (CI 同环境) =="
$PY -m pytest -q --tb=short

echo "OK: lint + tests"
exit 0