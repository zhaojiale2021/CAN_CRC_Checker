#!/bin/sh
# ============================================================
#  Pre-push hook: run backend lint and coverage-gated tests.
#  When uv is available, use Python 3.11, one of CI's backend matrix versions.
#  This hook does not run the remaining Python versions, Windows job, or
#  frontend checks; CI remains the full validation matrix.
#
#  Installed from hooks/pre-push -> .git/hooks/pre-push
#  (run install-hooks.bat after cloning; .git/hooks is not
#  version-controlled, so the source lives in hooks/)
# ============================================================
set -e

TOPLEVEL=$(git rev-parse --show-toplevel)
cd "$TOPLEVEL"

if command -v uv >/dev/null 2>&1; then
    # --no-project avoids creating uv.lock; this project uses requirements.txt.
    USE_UV=1
else
    USE_UV=0
    echo "WARNING: uv not found; using the current interpreter ($(python -V 2>&1))." \
         "Install uv to run the hook with CI's Python 3.11 interpreter." >&2
fi

run_python() {
    if [ "$USE_UV" = "1" ]; then
        uv run --no-project --python 3.11 --with-requirements requirements.txt python "$@"
    else
        python "$@"
    fi
}

echo "== pylint check (required: 0 messages, 10.00/10) =="
set +e
OUT=$(run_python -m pylint $(git ls-files '*.py') 2>&1)
RC=$?
set -e
echo "$OUT"

# A non-zero pylint exit code means at least one message was emitted.
if [ "$RC" != "0" ]; then
    echo "ERROR: pylint exited with status $RC; fix all messages before pushing." >&2
    exit 1
fi

SCORE=$(printf '%s\n' "$OUT" | sed -n 's/.*rated at \([0-9][0-9]*\(\.[0-9][0-9]*\)\{0,1\}\)\/10.*/\1/p' | tail -n1)
if [ -z "$SCORE" ]; then
    echo "ERROR: could not parse pylint score" >&2
    exit 1
fi
if [ "$SCORE" != "10.00" ]; then
    echo "ERROR: pylint score is $SCORE/10, need 10.00/10; fix issues before pushing." >&2
    exit 1
fi

echo "OK: pylint 10.00/10 (0 messages)"
echo "== pytest backend check (CI coverage threshold: 80%) =="
run_python -m pytest --tb=short --cov=crc_checker --cov=cli --cov=webapp \
    --cov-report=term --cov-fail-under=80

echo "OK: backend lint + coverage-gated tests"
exit 0
